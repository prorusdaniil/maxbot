MAX_BOT_TOKEN=вставьте_токен_бота_MAX
# Секрет вебхука: то же значение, что в поле secret запроса POST /subscriptions (A-Z, a-z, 0-9, _, -)
MAX_WEBHOOK_SECRET=вставьте_секрет_вебхука
# Необязательно: адрес и порт webhook-сервера
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8000
# WEBHOOK_PATH=/webhook
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=вставьте_ключ_DeepSeek
DEEPSEEK_MODEL=deepseek-flash
# GigaChat (если LLM_PROVIDER=gigachat)
GIGACHAT_CREDENTIALS=вставьте_ключ_авторизации_GigaChat
GIGACHAT_MODEL=GigaChat-2
# Необязательно: писать все запросы и ответы LLM в читаемом виде в файл
# LLM_LOG_FILE=logs/llm.log
