MAX_BOT_TOKEN=вставьте_токен_бота_MAX
# Секрет вебхука: то же значение, что в поле secret запроса POST /subscriptions (A-Z, a-z, 0-9, _, -)
MAX_WEBHOOK_SECRET=вставьте_секрет_вебхука
# Необязательно: корневой сертификат Минцифры для MAX API и GigaChat
# (по умолчанию certs/russian_trusted_root_ca.pem; system — использовать системное хранилище)
# RUSSIAN_CA_BUNDLE=/path/russian_trusted_root_ca.pem
# Необязательно: curl или stream (потоки PHP). По умолчанию stream, если curl собран с NSS
# HTTP_TRANSPORT=stream
# Необязательно: другой адрес MAX API (например, заглушка для проверки)
# MAX_API_URL=https://platform-api2.max.ru
# Необязательно: адреса API книг (по умолчанию counters.goweb.kz/book-parser)
# BOOK_API_URL=https://counters.goweb.kz/book-parser/api.php
# BOOKS_API_URL=https://counters.goweb.kz/book-parser/api/books
# RANDOM_FACT_API_URL=https://counters.goweb.kz/book-parser/api/random-fact
# Необязательно: файл журнала бота (по умолчанию logs/bot.log)
# BOT_LOG_FILE=logs/bot.log
# Уровень логирования: DEBUG, INFO, WARNING, ERROR (по умолчанию ERROR; DEBUG пишет запросы и ответы ИИ)
# LOG_LEVEL=ERROR
# Статистика использования включена по умолчанию; отключить: STATS_ENABLED=false
# STATS_ENABLED=true
# Необязательно: файл статистики использования (по умолчанию logs/stats.log)
# STATS_LOG_FILE=logs/stats.log
DEEPSEEK_API_KEY=вставьте_ключ_DeepSeek
DEEPSEEK_MODEL=deepseek-flash

# MySQL/MariaDB: состояние диалогов бота (webhook.php) и generate_details.php
# (php generate_details.php [--count=N] [--dry-run])
DB_HOST=localhost
DB_NAME=books
DB_USER=вставьте_пользователя_БД
DB_PASS=вставьте_пароль_БД
