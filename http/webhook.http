### Тестовые вебхуки MAX для локального бота (dev-режим)
# Запуск бота:  python -m dev        (см. README, раздел «Проверка без токенов»)
# Формат тел запросов повторяет обновления Bot API MAX: update_type = message_created | message_callback.
# Работает в VS Code (REST Client) и JetBrains HTTP Client. Выполняйте запросы по порядку:
# состояние диалога хранится в памяти бота.
#
# Ответы бота (то, что он отправил бы в MAX) печатаются в консоли dev-сервера,
# запросы к LLM — в файле logs/llm.log.

@host = http://127.0.0.1:8080
@secret = dev-secret

### 1. Текст: команда /start (бот покажет список книг)
POST {{host}}/webhook
Content-Type: application/json
X-Max-Bot-Api-Secret: {{secret}}

{
  "update_type": "message_created",
  "timestamp": 1761835990000,
  "message": {
    "sender": {
        "user_id": 111222333,
        "first_name": "Иван",
        "last_name": "Петров",
        "username": "ivan_petrov",
        "is_bot": false,
        "last_activity_time": 1761835980000
      },
    "recipient": {
      "chat_id": 555666777,
      "chat_type": "dialog",
      "user_id": 1000
    },
    "timestamp": 1761835990000,
    "body": {
      "mid": "mid.dev.user.1",
      "seq": 1,
      "text": "/start"
    }
  },
  "user_locale": "ru"
}

### 2. Кнопка: случайный факт (можно нажать сразу после /start)
POST {{host}}/webhook
Content-Type: application/json
X-Max-Bot-Api-Secret: {{secret}}

{
  "update_type": "message_callback",
  "timestamp": 1761835995000,
  "callback": {
    "timestamp": 1761835995000,
    "callback_id": "cb.dev.random_fact",
    "payload": "random_fact",
    "user": {
      "user_id": 111222333,
      "first_name": "Иван",
      "last_name": "Петров",
      "username": "ivan_petrov",
      "is_bot": false,
      "last_activity_time": 1761835980000
    }
  },
  "message": {
    "sender": { "user_id": 1000, "first_name": "Dev Bot", "username": "dev_bot", "is_bot": true, "last_activity_time": 1761835990000 },
    "recipient": {
      "chat_id": 555666777,
      "chat_type": "dialog",
      "user_id": 111222333
    },
    "timestamp": 1761835990000,
    "body": {
      "mid": "mid.dev.bot.1",
      "seq": 1,
      "text": "Привет! Выбери книгу:",
      "attachments": [
        {
          "type": "inline_keyboard",
          "payload": {
            "buttons": [
              [{ "type": "callback", "text": "Случайный факт", "payload": "random_fact" }],
              [{ "type": "callback", "text": "История 6 класс", "payload": "book:3" }]
            ]
          }
        }
      ]
    }
  },
  "user_locale": "ru"
}

